# Generic reference only; the server now uses .env.development or .env.production.
# For local development, copy .env.development.example to .env.development.
# Production should use the hosting provider's secret configuration, not a local .env file.

PORT=3001

# Comma-separated list of origins allowed to call this API (your static site's
# dev server URL, e.g. http://localhost:5500 for VS Code Live Server, or
# http://127.0.0.1:5500). No trailing slashes.
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Local SQLite file for application data and the full SQLite-provider rollback.
DATABASE_PATH=./data/RAFA-events.db

# Separate auth-state file used by the Supabase admin-auth provider. Preserve it.
ADMIN_AUTH_DATABASE_PATH=./data/RAFA-admin-auth.db

# Supabase is the default website content and submission provider. Set to sqlite to roll back.
WEBSITE_DATA_PROVIDER=supabase

# Supabase Auth is the default administrator identity provider. Set to sqlite to roll back.
ADMIN_AUTH_PROVIDER=supabase

# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Encrypts authenticator secrets at rest. Keep the actual value private.
RAFA_AUTH_ENCRYPTION_KEY=replace-with-base64-encoded-random-32-byte-key

# Supabase server integration. Obtain these from Project Settings -> API.
# The service-role key is server-only and must never be sent to a browser or committed.
SUPABASE_URL=https://jpitvhgyjsalswjuuwpm.supabase.co
SUPABASE_ANON_KEY=replace-with-development-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-development-project-service-role-key

# Public inquiry anti-spam and notification settings.
# Create separate Turnstile site/secret keys for the local frontend origin.
TURNSTILE_SITE_KEY=0x4AAAAAAGVcRhFUHKwvjjyJ
TURNSTILE_SECRET_KEY=0x4AAAAAAGVcRuiyCsZ4Y6Fmh4zwHKv7Jkc
# Comma-separated notification recipients; keep provider credentials server-side.
INQUIRY_NOTIFICATION_RECIPIENTS=
INQUIRY_EMAIL_FROM=
RESEND_API_KEY=0x4AAAAAAGVcRuiyCsZ4Y6Fmh4zwHKv7Jkc
# Flag inquiries that have had no activity for this many days.
INQUIRY_FOLLOW_UP_DAYS=3
